# Copy this file to a file named  .env  at the REPO ROOT (../.env from here), then fill in.
# .env is gitignored and read server-side only; the key never reaches the browser.

# Required for real runs (get one at https://openrouter.ai/keys):
OPENROUTER_API_KEY=sk-or-...

# Optional: override the default backbones (OpenRouter model slugs).
# Mediation model and auditor model can differ; keep the auditor constant across a study.
ROOMBRIDGE_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
ROOMBRIDGE_AUDITOR_MODEL=anthropic/claude-sonnet-4.5

# Optional governance flag (booth live entry). Defaults to true.
